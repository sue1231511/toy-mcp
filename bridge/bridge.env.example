# Required
BRIDGE_CLOUD_URL=wss://YOUR-RELAY-HOST/ws
BRIDGE_TOKEN=change-me-same-as-relay

# Optional (defaults shown)
# INTIFACE_URL=ws://127.0.0.1:12345
# 要管的玩具，按设备名里包含的字（不分大小写），逗号分隔。旧的 VELVO_DEVICE_HINT 仍然有效
# TOY_DEVICE_HINTS=velvo,kisstoy
# 通道别名：玩具:通道=名字,...；多个玩具用分号隔开。KissToy 默认如下（上面滑条=震动，下面=吮吸）
# CHANNEL_ALIASES=kisstoy:vibrate1=震动,vibrate2=吮吸
# MAX_COMMAND_SECONDS=600
# RAMP_TICK_SECONDS=0.5
# REASSERT_ON_CHANGE=true
# SCAN_RETRY_SECONDS=10
# BRIDGE_LOG_FILE=bridge.log
